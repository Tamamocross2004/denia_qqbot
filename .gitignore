# ---------- 密钥 ----------
qqbot/.env
*.key
*.pem

# ---------- 运行时数据 ----------
# memory.db 里有群友的聊天记录和提取出的记忆，不进仓库
qqbot/memory.db
qqbot/memory.db-journal
qqbot/memory.db-wal
qqbot/logs/

# ---------- 本地配置 ----------
# config.json 里有真实的群号和 QQ 号，仓库里放 config.example.json
qqbot/config.json
# notify.json 里有 SMTP 授权码和收件地址，绝不入库
qqbot/notify.json

# ---------- 依赖与缓存 ----------
qqbot/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/

# ---------- 第三方与二进制 ----------
# napcat 是 112M 的第三方协议端，按 README 自己下载
napcat/
# snowluma 是试用中的另一个协议端（111M，含 node.exe），同样不入库
snowluma/
bin/

# ---------- 备份与临时 ----------
qqbot/_bak/
qqbot/inbox/
*.tmp
*.log
_msg.txt
_*.txt

# ---------- 本地工作区元数据 ----------
# .workbuddy 里有开发笔记，含真实 QQ 号和群号
.workbuddy/

# ---------- 声音克隆（模型 + 训练环境，几个 G）----------
# 只放行验证脚本；venv310 / GPT-SoVITS / 权重 / 参考音频都不进仓库
tts/*
!tts/*.py
